// DuyOS fastfetch config: custom logo, default module list.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "/usr/share/duyos/logo.txt",
        "color": { "1": "38;2;125;211;252", "2": "38;2;196;181;253" }
    },
    "display": { "color": { "keys": "38;2;125;211;252" } },
    "modules": [
        "title", "separator", "os", "kernel", "uptime", "packages", "shell",
        "wm", "terminal", "cpu", "gpu", "memory", "swap", "disk", "localip", "break", "colors"
    ]
}
