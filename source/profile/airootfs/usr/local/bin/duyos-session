#!/usr/bin/env bash
# DuyOS session launcher: sanity-checks the graphics stack, then starts Hyprland
# (which autostarts the Caelestia shell). If Hyprland fails we fall back to the TTY
# with a hint instead of looping, so the system stays usable in any VM.
set -u

if [[ -n "${WAYLAND_DISPLAY:-}" ]]; then
    echo "duyos-session: already inside a Wayland session." >&2
    exit 1
fi

virt="$(systemd-detect-virt 2>/dev/null || echo none)"
log_dir="${XDG_STATE_HOME:-$HOME/.local/state}/duyos"
mkdir -p "$log_dir"

if ! compgen -G '/dev/dri/renderD*' >/dev/null; then
    printf '\e[33mWarning:\e[0m no GPU render node (/dev/dri/renderD*) found (virt: %s).\n' "$virt"
    echo "Hyprland needs GPU acceleration. In QEMU/virt-manager use 'virtio-vga-gl' / Virtio + 3D,"
    echo "in VirtualBox enable 'VMSVGA + 3D acceleration'. Trying anyway..."
    sleep 3
fi

echo "Starting Hyprland + Caelestia (log: $log_dir/hyprland.log)..."
if command -v start-hyprland >/dev/null; then
    start-hyprland >"$log_dir/hyprland.log" 2>&1
else
    Hyprland >"$log_dir/hyprland.log" 2>&1
fi
status=$?

if (( status != 0 )); then
    printf '\n\e[31mHyprland exited with status %d.\e[0m Last lines of the log:\n' "$status"
    tail -n 15 "$log_dir/hyprland.log"
    echo
    echo "You are in the DuyOS text console. Fix the VM graphics settings and run: duyos-session"
fi
